# Input data (absolute paths are recommended for external datasets)
IMAGES_DIR=./data/images
LABELS_EXT_DIR=./data/labels_extended
YOLO_MODEL_PATH=./models/yolo_detector.pt

# Project data and generated files (relative paths resolve from the project root)
ASSETS_DIR=./graph_reconstruction/assets
ANNOTATIONS_DIR=./data/graph_annotations
WORK_DIR=./output

# Optional diagnostics. Keep disabled for compact normal runs.
DEBUG_OUTPUT_ENABLED=false
DEBUG_OUTPUT_DIR=./output/debug

# VGGT
VGGT_EDGE_ENABLED=true
VGGT_EDGE_SEARCH_GLOB=vggt
VGGT_GENERATE_IF_MISSING=true
# Facoltativo: se omesso, VGGT usa il Python dell'ambiente Conda attivo.
# VGGT_EMBEDDED_PYTHON=/percorso/assoluto/al/python
VGGT_MODEL_ID=facebook/VGGT-1B
VGGT_PREPROCESS_MODE=crop
VGGT_3D_ADJACENCY_FACTOR=1.35
VGGT_3D_MUTUAL_TOP_K=3
VGGT_3D_MIN_POINTS_PER_OBSERVATION=12
VGGT_3D_MAX_POINTS_PER_OBSERVATION=256
