# Manuale LaTeX: sorgenti, figure usate e PDF verificato sono versionati;
# restano esclusi soltanto gli artefatti intermedi della compilazione.
docs/technical_manual/**/*.aux
docs/technical_manual/*.log
docs/technical_manual/*.toc
docs/technical_manual/*.out
docs/technical_manual/*.fls
docs/technical_manual/*.fdb_latexmk
docs/technical_manual/*.synctex.gz
docs/technical_manual/figures/vggt_geometry.png

# Dataset locale: si mantiene soltanto la struttura delle directory.
data/images/*
!data/images/.gitkeep
data/labels_extended/*
!data/labels_extended/.gitkeep

# Pipeline output — ignore all generated artifacts,
# except VGGT point maps (expensive to recompute, ~minutes per node).
# Rules must be specified level-by-level: git cannot re-include a file
# once its parent directory is excluded.
output/*
!output/multiview/
output/multiview/*
!output/multiview/*/
output/multiview/*/*
!output/multiview/*/vggt/
output/multiview/*/vggt/*
!output/multiview/*/vggt/*.npz
!output/multiview/*/vggt/*.json
